{
  "name": "ronin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Supervisor autonomo para implementacion de specs via GitHub como maquina de estados",
  "scripts": {
    "tick": "tsx src/apps/api/tick/main.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json && tsc --noEmit -p src/apps/portal && tsc --noEmit -p src/apps/dashboard",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && vite build --config src/apps/dashboard/vite.config.ts --logLevel warn && vite build --config src/apps/portal/vite.config.ts --logLevel warn",
    "portal:dev": "vite --config src/apps/portal/vite.config.ts",
    "start": "node dist/apps/api/main.js",
    "smoke-test": "tsx scripts/smoke-test.ts",
    "timings": "tsx scripts/timings.ts",
    "review:dry-run": "tsx scripts/review-dry-run.ts",
    "fix:replay": "tsx scripts/fix-replay.ts",
    "app": "tsx --env-file=.env scripts/app.ts",
    "explore": "tsx --env-file=.env scripts/explore.ts",
    "browsers:install": "playwright install chromium && playwright-mcp install-browser chrome-for-testing",
    "init-labels": "bash scripts/init-labels.sh",
    "cron:setup": "bash scripts/setup-cron.sh",
    "cron:remove": "bash scripts/setup-cron.sh --remove",
    "server": "tsx src/apps/api/main.ts",
    "init-webhooks": "bash scripts/init-webhooks.sh",
    "server:setup": "bash scripts/setup-server-service.sh",
    "server:remove": "bash scripts/setup-server-service.sh --remove",
    "db:migrate": "tsx --env-file=.env scripts/db-migrate.ts",
    "db:import-settings": "tsx --env-file=.env scripts/db-import-settings.ts",
    "db:import-deploys": "tsx --env-file=.env scripts/db-import-deploys.ts",
    "db:import-meetings": "tsx --env-file=.env scripts/db-import-meetings.ts",
    "db:import-portal": "tsx --env-file=.env scripts/db-import-portal.ts",
    "db:import-local-state": "tsx --env-file=.env scripts/db-import-local-state.ts",
    "db:import-runs": "tsx --env-file=.env scripts/db-import-runs.ts",
    "db:import-usage": "tsx --env-file=.env scripts/db-import-usage.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "@hono/zod-validator": "0.9.1",
    "@playwright/mcp": "0.0.83",
    "@tanstack/react-query": "5.104.1",
    "gray-matter": "^4.0.3",
    "hono": "4.13.13",
    "kysely": "0.29.6",
    "mammoth": "1.13.0",
    "nodemailer": "^6.9.16",
    "pg": "8.23.1",
    "playwright": "1.64.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "unpdf": "1.8.1",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "jszip": "3.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "8.3.3",
    "vitest": "^4.1.10"
  }
}
