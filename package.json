{
  "name": "valeria",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Supervisor autonomo para implementacion de specs via GitHub como maquina de estados",
  "scripts": {
    "tick": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "smoke-test": "tsx scripts/smoke-test.ts",
    "init-labels": "bash scripts/init-labels.sh",
    "cron:setup": "bash scripts/setup-cron.sh",
    "cron:remove": "bash scripts/setup-cron.sh --remove"
  },
  "dependencies": {
    "@octokit/auth-app": "^8.2.0",
    "gray-matter": "^4.0.3",
    "nodemailer": "^6.9.16"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
