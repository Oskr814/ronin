{
  "name": "ronin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Supervisor autonomo para implementacion de specs via GitHub como maquina de estados",
  "scripts": {
    "tick": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "smoke-test": "tsx scripts/smoke-test.ts",
    "review:dry-run": "tsx scripts/review-dry-run.ts",
    "fix:replay": "tsx scripts/fix-replay.ts",
    "app": "tsx --env-file=.env scripts/app.ts",
    "init-labels": "bash scripts/init-labels.sh",
    "cron:setup": "bash scripts/setup-cron.sh",
    "cron:remove": "bash scripts/setup-cron.sh --remove",
    "webhook-server": "tsx src/webhook-server.ts",
    "init-webhooks": "bash scripts/init-webhooks.sh",
    "webhook:setup": "bash scripts/setup-webhook-service.sh",
    "webhook:remove": "bash scripts/setup-webhook-service.sh --remove"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "nodemailer": "^6.9.16",
    "playwright": "1.64.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
