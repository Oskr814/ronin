# Repo del producto que contiene los specs y donde se abren issues/PRs
PRODUCT_REPO=Bmedical/bmedical
PRODUCT_REPO_PATH=/home/link/Bmedical/bmedical

# GitHub App dedicado a ValerIA (no un usuario/PAT personal).
# Setup manual, ver docs/DESIGN.md §7 — no automatizable desde el supervisor.
VALERIA_GITHUB_APP_ID=
VALERIA_GITHUB_APP_PRIVATE_KEY_PATH=
VALERIA_GITHUB_APP_INSTALLATION_ID=

SPEC_DIR=docs/superpowers

# Dónde vive cada worktree desechable por tarea (ver docs/DESIGN.md §7.1). Default: sibling de PRODUCT_REPO_PATH.
WORKTREE_BASE_PATH=

# Timeout de una invocación headless de `claude -p` antes de considerarla colgada
AGENT_TASK_TIMEOUT_MINUTES=30

# Binario a invocar para las corridas headless. Casi nunca hace falta cambiar esto —
# ver CLAUDE_CONFIG_DIR abajo para el caso de múltiples cuentas.
CLAUDE_COMMAND=claude

# Si tenés múltiples cuentas de Claude en esta máquina vía alias de shell
# (ej. "claude-bmedical" = CLAUDE_CONFIG_DIR=~/.claude-bmedical command claude),
# el alias es invisible para execFile — seteá acá el mismo path directamente.
CLAUDE_CONFIG_DIR=

# Notificador de bloqueos (Gmail SMTP con app password, no la password de la cuenta)
GMAIL_USER=
GMAIL_APP_PASSWORD=
NOTIFY_TO=

# Reintentos antes de marcar bloqueo (ver docs/BLOCKING.md)
E2E_RETRY_LIMIT=2
SLICE_ATTEMPT_LIMIT=3

# Opt-in: fuera del loop core por defecto (ver docs/DESIGN.md §3)
REQUEST_COPILOT_REVIEW=false

# Tu usuario de GitHub (ej. oskr814), NO un hostname. Usado tanto para que te asignen
# specs (label valeria:runner-<esto> en el PR del spec) como para el claim de issues
# entre supervisores concurrentes (ver docs/DESIGN.md §1 y §9). Requerido, sin default.
RUNNER_ID=

# Cache local de issues ya reclamados por esta máquina — nunca commitear (ya está en .gitignore)
LOCAL_STATE_PATH=.valeria-state.json

# Repo de ValerIA — la evidencia de e2e (screenshots) se commitea acá (main), no en PRODUCT_REPO (ver docs/DESIGN.md §4)
VALERIA_REPO=Bmedical/ValerIA

# Carpeta de screenshots de Playwright, relativa a la raíz de PRODUCT_REPO (ver apps/webapp/playwright.config.ts en bmedical)
PLAYWRIGHT_TEST_RESULTS_DIR=apps/webapp/test-results
