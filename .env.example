# Lista de repos a supervisar — ver repos.json.example y
# docs/superpowers/specs/2026-08-19-multi-repo-pat-auth-design.md.
# repos.json real va gitignored, nunca se commitea. Default: ./repos.json.
REPOS_CONFIG_PATH=

# Fine-grained PAT de la cuenta de GitHub dedicada `ronin` (no un usuario/PAT
# personal), scopeado a Contents/Issues/Pull requests read-write sobre los
# repos de repos.json, con expiración. Setup manual, ver la wiki: https://github.com/Oskr814/ronin/wiki/Setup
RONIN_GITHUB_TOKEN=

# Username real de esa cuenta (sin sufijo [bot], no es un GitHub App) — su
# @mención es la señal para pedirle una review puntual (ver la wiki: https://github.com/Oskr814/ronin/wiki/Comandos), y es
# la identidad usada para los commits de evidencia (evidence-store.ts).
RONIN_GITHUB_LOGIN=

# Carpeta del repo del producto donde un PR de spec trae sus .md (docs/DESIGN.md §1).
SPEC_DIR=docs/superpowers

# Dónde vive cada worktree desechable por tarea (ver docs/DESIGN.md §7.1).
# Default: sibling del productRepoPath de cada entrada de repos.json.
# ⚠️ Con más de un repo en repos.json, setear esto es inseguro — dos repos
# con el mismo número de issue colisionarían en el mismo directorio. Dejar
# en blanco (default: sibling de cada productRepoPath) salvo que solo
# tengas un repo.
WORKTREE_BASE_PATH=

# Rama base de los worktrees y de los stacks cuando la entrada de repos.json
# no trae su propio worktreeBaseRef (ej. "origin/odoo-main").
WORKTREE_BASE_REF=origin/main

# Timeout de una invocación headless de `claude -p` antes de considerarla colgada
AGENT_TASK_TIMEOUT_MINUTES=30

# Binario a invocar para las corridas headless. Casi nunca hace falta cambiar esto —
# ver CLAUDE_CONFIG_DIR abajo para el caso de múltiples cuentas.
CLAUDE_COMMAND=claude

# Modelo y esfuerzo de todas las corridas headless (--model / --effort). Van
# explícitos a propósito: el settings.json de CLAUDE_CONFIG_DIR se comparte
# con las sesiones interactivas, y un /model ahí se guarda como default para
# todos los agentes. Vacío = lo que diga la config de Claude.
AGENT_MODEL=opus
AGENT_EFFORT=high
# Por tipo de tarea: AGENT_MODEL_<TIPO> / AGENT_EFFORT_<TIPO>, con el tipo en
# mayúsculas y guiones bajos (ej. AGENT_MODEL_FIX_REVIEW=sonnet). Pisan el
# global solo para ese tipo. update-changelog usa haiku por defecto.
# AGENT_MODEL_UPDATE_CHANGELOG=haiku
# Una cuenta con límites más bajos puede tener sus propios valores en el
# bloque "agent" de su entrada de repos.json (ver repos.json.example): su
# "model"/"effort" reemplazan a AGENT_MODEL/AGENT_EFFORT para ese repo, y sus
# "models"/"efforts" por tipo de tarea ganan incluso sobre estas variables.

# Default global de CLAUDE_CONFIG_DIR — una entrada de repos.json puede
# pisarlo por repo con su propio claudeConfigDir (ver la wiki: https://github.com/Oskr814/ronin/wiki/Setup, y
# repos.json.example).
CLAUDE_CONFIG_DIR=

# Notificador de bloqueos (Gmail SMTP con app password, no la password de la cuenta)
GMAIL_USER=
GMAIL_APP_PASSWORD=
NOTIFY_TO=

# Reintentos antes de marcar bloqueo (ver docs/BLOCKING.md)
E2E_RETRY_LIMIT=2
# Tope duro de intentos con CI fallando cuando cada intento falla distinto
# (la firma de la falla cambia, así que hay progreso). E2E_RETRY_LIMIT pasa
# a contar las veces que se repite una misma falla.
E2E_ATTEMPT_HARD_LIMIT=5
SLICE_ATTEMPT_LIMIT=3
RETARGET_RETRY_LIMIT=3
ISSUE_ERROR_RETRY_LIMIT=3
# Ticks que se tolera un CI con checks pendientes (sin reportar o todavía
# corriendo) antes de bloquear: con el cron de a 5 min, 60 ticks son unas 5 h.
# Separado de E2E_RETRY_LIMIT porque "CI corriendo" nunca debería bloquear
# por sí solo (ver docs/BLOCKING.md); esto es solo la red de seguridad contra
# un workflow que nunca dispara.
CHECKS_PENDING_RETRY_LIMIT=60

# Opt-in: fuera del loop core por defecto (ver docs/DESIGN.md §3)
REQUEST_COPILOT_REVIEW=false

# Modelo de los workers de la review de PRs externos: los agentes
# especializados de prompts/review-agents/, uno por dimensión. Solo juntan
# candidatos; el orquestador verifica y decide qué se publica (ver
# docs/superpowers/specs/2026-10-10-exhaustive-external-review-design.md).
EXTERNAL_REVIEW_WORKER_MODEL=sonnet

# Tareas que un tick corre a la vez por repo, de todos los flujos juntos
# (issues, reviews externas, /spike y pedidos en issues, changelog, el PR de
# exploración), y cuántas de ellas pueden ser
# reviews externas: cada review es un orquestador más sus workers, y tres a la
# vez agotaron el límite de sesión de la cuenta.
TICK_CONCURRENCY=3
EXTERNAL_REVIEW_CONCURRENCY=2

# Tu usuario de GitHub (ej. oskr814), NO un hostname. Mismo valor para todos
# los repos de repos.json. Es el label ronin:runner-<esto> con el que este
# runner reclama un issue frente a otros supervisores (ver docs/DESIGN.md §9).
# Los specs ya no se asignan con este label sino con Assignees (§1).
# Requerido, sin default.
RUNNER_ID=

# Cache local de issues ya reclamados por esta máquina, namespaced por repo
# (ver local-state.ts) — nunca commitear (ya está en .gitignore)
LOCAL_STATE_PATH=.ronin-state.json

# --- Opcional: webhook-server (ver la wiki: https://github.com/Oskr814/ronin/wiki/Webhooks) ---
# Solo lo lee webhook-server.ts — `pnpm tick`/el cron funcionan igual sin
# configurar nada de esto.

# Secreto compartido entre el webhook registrado en GitHub y webhook-server —
# generar con `openssl rand -hex 32`. Requerido para levantar webhook-server.
WEBHOOK_SECRET=

# Puerto local donde escucha webhook-server (proxyeado desde afuera vía tu
# reverse proxy/túnel — ver la wiki: https://github.com/Oskr814/ronin/wiki/Webhooks).
WEBHOOK_PORT=3939

# Cuánto esperar (ms) para juntar una ráfaga de eventos sobre el mismo issue o
# PR (los comentarios de una review, varios checks que terminan juntos) en un
# solo handler, en vez de lanzar uno por evento.
WEBHOOK_DEBOUNCE_MS=1000

# --- Opcional: exploración (docs/DESIGN.md §11) ---
# Requiere un ronin.app.json en el repo del producto y los navegadores:
# `pnpm browsers:install` una vez por runner.

# Cuántas funciones prueba una corrida de /explore, y cuánto de lo que
# encuentra se publica: hallazgos por gravedad, ideas nunca en su lugar.
EXPLORE_FUNCTIONS_PER_RUN=3
EXPLORE_FINDINGS_PER_RUN=8
EXPLORE_IDEAS_PER_RUN=2

# Subir las capturas (antes/después) de las propuestas a la rama huérfana
# ronin/evidence del repo del producto, para mostrarlas en las fichas y el PR.
# En false quedan solo en el disco del runner y la ficha las describe en texto.
EXPLORE_PUBLISH_EVIDENCE=true

# Zona horaria (nombre IANA) de la exploración: la ventana nocturna, la fecha
# de cada corrida y la semana de su PR. Solo eso: los logs y el resto de
# ronin siguen con la hora del server.
EXPLORE_TIMEZONE=America/Tegucigalpa

# Exploración nocturna de las apps listadas en "explore" de cada repo en
# repos.json, en la hora de EXPLORE_TIMEZONE (puede cruzar la medianoche).
# Usa el límite semanal de Claude de la cuenta, compartido con el trabajo de
# día: el tope de funciones por noche es el presupuesto.
EXPLORE_NIGHT_WINDOW=01:00-06:00
EXPLORE_FUNCTIONS_PER_NIGHT=3

# --- Opcional: preguntas por Remote Control (docs/DESIGN.md §11.9) ---
# Cuando un issue queda en needs-info, además de las preguntas en el issue,
# ronin abre una conversación con Remote Control para responderlas más
# rápido. Solo la puede abrir la cuenta de Claude del runner; el resto del
# equipo responde comentando en el issue, como siempre.
REMOTE_INTERVIEWS=true
INTERVIEW_TIMEOUT_HOURS=24

# --- Opcional: /preview (docs/DESIGN.md §12) ---
# Después de los seeds base, un agente lee el PR (sus pasos de prueba, su
# diff y lo que se pidió junto al comando) y deja los datos para probarlo.
# En false, la preview es solo la app con sus seeds.
PREVIEW_PREPARE_DATA=true

# Puertos de la tailnet donde se publican las previews: lo único que una
# política de Tailscale tiene que abrirle a alguien de afuera. Fuera del
# rango efímero del kernel (32768-60999), donde caen Docker y los Postgres
# de las slices.
PREVIEW_PORT_RANGE=20000-20999

# Previews activas a la vez por repo, sea cual sea la app; la siguiente se
# rechaza.
PREVIEW_MAX_PER_REPO=2

# Dónde se reservan los puertos públicos y los cupos de las previews,
# compartido por todos los repos y workers de este runner.
PREVIEW_RESERVATIONS_DIR=.preview-reservations

# Minutos que vive una preview desde que se levanta, si nadie la baja antes
# con /preview stop ni se mergea o cierra el PR. Un /preview nuevo empieza
# la cuenta de nuevo. En 0, no vence.
PREVIEW_TTL_MINUTES=60
