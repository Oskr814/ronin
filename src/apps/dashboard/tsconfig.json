{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "paths": {
      "@apps/*": ["../../apps/*"],
      "@domains/*": ["../../domains/*"],
      "@platform/*": ["../../platform/*"],
      "@ui/*": ["../../ui/*"]
    }
  },
  "include": ["src", "../../ui", "vite.config.ts"]
}
