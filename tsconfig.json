{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "src",
    "noEmitOnError": true
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/apps/dashboard",
    "src/apps/portal",
    "src/ui"
  ]
}
