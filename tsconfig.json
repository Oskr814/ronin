{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "src",
    "noEmitOnError": true,
    "paths": {
      "@apps/*": ["./src/apps/*"],
      "@domains/*": ["./src/domains/*"],
      "@platform/*": ["./src/platform/*"],
      "@ui/*": ["./src/ui/*"]
    }
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/apps/dashboard",
    "src/apps/portal",
    "src/ui"
  ]
}
